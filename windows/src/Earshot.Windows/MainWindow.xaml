<Window x:Class="Earshot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Earshot" Width="1100" Height="740" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen" Icon="Assets/earshot.ico"
        Style="{StaticResource {x:Type Window}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: recording, the job in progress, the sessions. -->
        <Border Grid.Column="0" Background="#FBFAFE" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,14,16,12">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,14">
                    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" Click="OnSettings" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/earshot.ico" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Earshot" FontSize="21" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" />
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBox x:Name="TitleBox" TextChanged="OnTitleChanged" MaxLength="120" />
                            <TextBlock x:Name="TitleHint" IsHitTestVisible="False" Margin="11,0,8,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock x:Name="MicLabel" Style="{StaticResource Label}" Margin="0,12,0,6" />
                        <ComboBox x:Name="MicBox" DisplayMemberPath="Name" SelectionChanged="OnMicChanged" />
                        <Button x:Name="RecordButton" Style="{StaticResource RecordButton}" Margin="0,14,0,0" Click="OnRecord">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RecordGlyph" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Text="&#xE7C8;" />
                                <TextBlock x:Name="RecordText" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="LivePanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock x:Name="ElapsedText" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="PcLabel" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ProgressBar x:Name="PcMeter" Grid.Column="1" Maximum="1" VerticalAlignment="Center" />
                                <TextBlock x:Name="MicMeterLabel" Grid.Row="1" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,8,10,0" />
                                <ProgressBar x:Name="MicMeter" Grid.Row="1" Grid.Column="1" Maximum="1" VerticalAlignment="Center" Margin="0,8,0,0" />
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="RecordHint" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="JobPanel" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="JobTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="JobText" Style="{StaticResource Muted}" Margin="0,2,0,8" />
                        <ProgressBar x:Name="JobBar" Maximum="1" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="SessionsLabel" DockPanel.Dock="Top" Style="{StaticResource Label}" Margin="4,18,0,6" />
                <ListBox x:Name="SessionList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SessionItem}"
                         SelectionChanged="OnSessionSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="12" Visibility="{Binding StatusVisibility}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right: the transcript. -->
        <Grid Grid.Column="1" Background="{StaticResource CardBrush}">
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" TextAlignment="Center"
                       Style="{StaticResource Muted}" FontSize="14" />
            <DockPanel x:Name="DetailPanel" Visibility="Collapsed" Margin="40,30,28,0">
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                        <Button x:Name="RetryButton" Click="OnRetry" Visibility="Collapsed" Margin="0,0,8,0" Style="{StaticResource AccentButton}" />
                        <Button x:Name="SummarizeButton" Click="OnSummarize" Visibility="Collapsed" Margin="0,0,8,0" />
                        <Button x:Name="FolderButton" Click="OnOpenFolder" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <TextBlock x:Name="DetailSubtitle" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="DetailStatus" DockPanel.Dock="Top" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="RenameHint" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,16,0,4" />
                <ScrollViewer x:Name="TurnScroller" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" PreviewMouseWheel="OnTurnWheel">
                    <StackPanel>
                    <Border x:Name="SummaryPanel" Visibility="Collapsed" Background="{StaticResource AccentSoftBrush}" CornerRadius="10"
                            Padding="18,14" Margin="0,0,12,22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" FontSize="15" />
                                <TextBlock x:Name="SummaryHeading" FontWeight="SemiBold" FontSize="15" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="14" LineHeight="21" />
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="TurnList" Margin="0,0,12,32">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Click="OnRenameSpeaker" Tag="{Binding}" Padding="5,2" Margin="-5,0,0,0"
                                                ToolTip="{Binding RenameTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SpeakerText}" FontWeight="SemiBold" Foreground="{Binding Brush}" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource ReadingText}" Text="{Binding Text, Mode=OneWay}" Margin="0,5,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
