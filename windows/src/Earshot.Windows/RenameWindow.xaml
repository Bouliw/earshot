<Window x:Class="Earshot.Desktop.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}" Background="{StaticResource CardBrush}">
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="Hint" Style="{StaticResource Muted}" Margin="0,6,0,14" />
        <TextBox x:Name="NameBox" MaxLength="80" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" IsCancel="True" Margin="0,0,8,0" MinWidth="88" />
            <Button x:Name="OkButton" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="88" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
