<Window x:Class="Earshot.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}" Background="{StaticResource CardBrush}">
    <DockPanel Margin="24,20,24,18">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"
                   FontFamily="Segoe UI Variable Display, Segoe UI" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" IsCancel="True" Margin="0,0,8,0" MinWidth="96" />
            <Button x:Name="SaveButton" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="96" Click="OnSave" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="AppLanguageLabel" Style="{StaticResource Label}" />
                <ComboBox x:Name="AppLanguageBox" DisplayMemberPath="Text" Margin="0,0,0,18" />

                <TextBlock x:Name="ModelLabel" Style="{StaticResource Label}" />
                <ComboBox x:Name="ModelBox" DisplayMemberPath="Text" />
                <TextBlock x:Name="ModelHint" Style="{StaticResource Muted}" Margin="0,6,0,0" />

                <TextBlock x:Name="LanguageLabel" Style="{StaticResource Label}" Margin="0,18,0,6" />
                <ComboBox x:Name="LanguageBox" DisplayMemberPath="Text" />

                <TextBlock x:Name="NameLabel" Style="{StaticResource Label}" Margin="0,18,0,6" />
                <TextBox x:Name="NameBox" MaxLength="80" />

                <CheckBox x:Name="VoicesBox" Margin="0,18,0,0" FontWeight="SemiBold" />
                <TextBlock x:Name="VoicesHint" Style="{StaticResource Muted}" Margin="22,4,0,0" />

                <CheckBox x:Name="SummarizeBox" Margin="0,18,0,0" FontWeight="SemiBold" />
                <TextBlock x:Name="SummarizeHint" Style="{StaticResource Muted}" Margin="22,4,0,0" />
                <TextBlock x:Name="SummaryModelLabel" Style="{StaticResource Label}" Margin="22,12,0,6" />
                <ComboBox x:Name="SummaryModelBox" DisplayMemberPath="Text" Margin="22,0,0,0" />
                <TextBlock x:Name="SummaryModelHint" Style="{StaticResource Muted}" Margin="22,6,0,0" />

                <TextBlock x:Name="FolderLabel" Style="{StaticResource Label}" Margin="0,18,0,6" />
                <DockPanel>
                    <Button x:Name="OpenButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnOpen" />
                    <Button x:Name="ChooseButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnChoose" />
                    <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,22,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
